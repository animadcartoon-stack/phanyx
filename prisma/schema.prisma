model Turma {
  id                              Int                             @id @default(autoincrement())
  nome                            String
  semestre                        String
  professorId                     Int?
  instituicaoId                   Int
  ativa                           Boolean                         @default(true)
  codigo                          String?
  createdAt                       DateTime                        @default(now())
  periodoLetivo                   String?
  turno                           String?
  modalidade                      String?
  predio                          String?
  ala                             String?
  andar                           String?
  sala                            String?
  updatedAt                       DateTime                        @updatedAt
  capacidadeMaxima                Int?
  capacidadeMinima                Int?
  cursoId                         Int?
  dataInicio                      DateTime?
  dataFim                         DateTime?
  statusTurma                     StatusTurma                     @default(AGUARDANDO)
  atividades                      Atividade[]
  aulas                           Aula[]
  itensMatricula                  ItemMatricula[]
  modulos                         Modulo[]
  notas                           Nota[]
  provas                          Prova[]
  resultadosFinais                ResultadoFinal[]
  curso                           Curso?                          @relation(fields: [cursoId], references: [id])
  instituicao                     Instituicao                     @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  professor                       Professor?                      @relation(fields: [professorId], references: [id])
  disciplinas                     TurmaDisciplina[]
  semestres                       TurmaSemestre[]
  periodosMatriculaParticipantes PeriodoMatriculaTurma[]
  poloId                          Int?
  polo                            Polo?                           @relation(fields: [poloId], references: [id])
  reunioes                        Reuniao[]
  substituicoesDocentes           SubstituicaoDocente[]
  destinosRecomendacoesBiblioteca BibliotecaRecomendacaoDestino[]

