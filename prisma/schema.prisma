  observacao    String?
  fechadoEm     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  instituicaoId Int
  alunoId       Int
  turmaId       Int
  disciplinaId  Int
  aluno         Aluno         @relation(fields: [alunoId], references: [id], onDelete: Cascade)
