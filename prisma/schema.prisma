  itensRematriculaSemestral RematriculaSemestralItem[]

  @@unique([turmaId, disciplinaId])
  @@index([turmaId])
  @@index([disciplinaId])
  @@index([professorId])
  @@index([instituicaoId])
}

model TurmaDisciplinaHorario {
