  liberaOutrasDisciplinas   DisciplinaPreRequisito[]        @relation("DisciplinaPreRequisito")
  permitidaComoExtraEm      CursoDisciplinaExtraPermitida[]
  turmaDisciplinas          TurmaDisciplina[]
  professoresHabilitados    ProfessorDisciplina[]
  aulas                     Aula[]
  atividades                Atividade[]
  substituicoesDocentes     SubstituicaoDocente[]

  @@unique([instituicaoId, nome])
  @@unique([instituicaoId, codigo])
  @@index([instituicaoId])
  @@index([cursoId])
  @@index([professorId])
}

model Turma {
  id                    Int                   @id @default(autoincrement())
  nome                  String
  semestre              String
  professorId           Int?
  instituicaoId         Int
  ativa                 Boolean               @default(true)
  codigo                String?
  createdAt             DateTime              @default(now())
  periodoLetivo         String?
  predio                String?
  ala                   String?
  andar                 String?
  sala                  String?
  updatedAt             DateTime              @updatedAt
  capacidadeMaxima      Int?
  capacidadeMinima      Int?
  cursoId               Int?
  dataInicio            DateTime?
  dataFim               DateTime?
  statusTurma           StatusTurma           @default(AGUARDANDO)
  atividades            Atividade[]
  aulas                 Aula[]
  itensMatricula        ItemMatricula[]
  modulos               Modulo[]
  notas                 Nota[]
  provas                Prova[]
  resultadosFinais      ResultadoFinal[]
  curso                 Curso?                @relation(fields: [cursoId], references: [id])
  instituicao           Instituicao           @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  professor             Professor?            @relation(fields: [professorId], references: [id])
  disciplinas           TurmaDisciplina[]
  semestres             TurmaSemestre[]
  poloId                Int?
  polo                  Polo?                 @relation(fields: [poloId], references: [id])
  reunioes              Reuniao[]
  substituicoesDocentes SubstituicaoDocente[]

  @@unique([instituicaoId, nome, semestre])
  @@index([instituicaoId])
  @@index([professorId])
  @@index([statusTurma])
  @@index([poloId])
}

model TurmaDisciplina {
  id              Int            @id @default(autoincrement())
  turmaId         Int
  disciplinaId    Int
  professorId     Int?
  instituicaoId   Int
  dataInicio      DateTime?
  dataFim         DateTime?
  status          String?
  turmaSemestreId Int?
  turmaSemestre   TurmaSemestre? @relation(fields: [turmaSemestreId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  turma       Turma                    @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  disciplina  Disciplina               @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  professor   Professor?               @relation(fields: [professorId], references: [id])
  instituicao Instituicao              @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  horarios    TurmaDisciplinaHorario[]

  @@unique([turmaId, disciplinaId])
  @@index([turmaId])
  @@index([disciplinaId])
  @@index([professorId])
  @@index([instituicaoId])
}

model TurmaDisciplinaHorario {
  id                Int      @id @default(autoincrement())
  turmaDisciplinaId Int
  instituicaoId     Int
  diaSemana         Int
  horaInicio        String
  horaFim           String?
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  turmaDisciplina TurmaDisciplina @relation(fields: [turmaDisciplinaId], references: [id], onDelete: Cascade)
  instituicao     Instituicao     @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)

  @@index([turmaDisciplinaId])
  @@index([instituicaoId])
  @@index([diaSemana])
  @@index([ativo])
}

model Matricula {
  id                              Int             @id @default(autoincrement())
  numeroMatriculaLegado           String?
  sistemaOrigem                   String?
  importadaSistemaAntigo          Boolean         @default(false)
  alunoId                         Int
  numeroMatricula                 String?
  modalidade                      String?
  createdAt                       DateTime        @default(now())
  instituicaoId                   Int
  poloId                          Int?
  status                          StatusMatricula @default(ATIVA)
  updatedAt                       DateTime        @updatedAt
  cursoId                         Int?
  semestre                        Int?
  dataPrimeiroVencimento          DateTime?
  quantidadeParcelas              Int?
  valorMatricula                  Decimal?        @db.Decimal(10, 2)
  valorMensalidade                Decimal?        @db.Decimal(10, 2)
  primeiroVencimento              DateTime?
  quantidadeMensalidades          Int?
  vendedorResponsavelId           Int?
  vendedorResponsavelNomeSnapshot String?
  origemComercial                 String?
  campanhaComercial               String?
  atendidoComercialEm             DateTime?
  observacaoComercial             String?         @db.Text

  contratos              Contrato[]
  documentos             DocumentoAluno[]
  documentosGerados      DocumentoGerado[]
  itens                  ItemMatricula[]
  lancamentosFinanceiros LancamentoFinanceiro[]
  vendedorResponsavel    Funcionario?           @relation("MatriculaVendedorResponsavel", fields: [vendedorResponsavelId], references: [id], onDelete: SetNull)

  participantesComerciais MatriculaParticipanteComercial[]
  lancamentosComissaoRH   LancamentoComissaoRH[]
  cursoSemestreId         Int?
  periodoMatriculaId      Int?
  periodoLetivo           String?
  realizadaPeloAluno      Boolean                          @default(false)
  confirmadaEm            DateTime?
  cursoSemestre           CursoSemestre?                   @relation(fields: [cursoSemestreId], references: [id])
  periodoMatricula        PeriodoMatricula?                @relation(fields: [periodoMatriculaId], references: [id])
  aluno                   Aluno                            @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  curso                   Curso?                           @relation(fields: [cursoId], references: [id])
  instituicao             Instituicao                      @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  polo                    Polo?                            @relation(fields: [poloId], references: [id])

  @@unique([instituicaoId, numeroMatricula])
  @@index([instituicaoId])
  @@index([alunoId])
  @@index([cursoId])
  @@index([cursoSemestreId])
  @@index([periodoMatriculaId])
  @@index([periodoLetivo])
  @@index([poloId])
  @@index([numeroMatricula])
  @@index([numeroMatriculaLegado])
  @@index([vendedorResponsavelId])
}

model ItemMatricula {
  id            Int                 @id @default(autoincrement())
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  instituicaoId Int
  matriculaId   Int
  turmaId       Int
  disciplinaId  Int
  tipoItem      TipoItemMatricula   @default(GRADE_PRINCIPAL)
  status        StatusItemMatricula @default(A_CURSAR)

  instituicao Instituicao @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  matricula   Matricula   @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  turma       Turma       @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  disciplina  Disciplina  @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)

  @@unique([matriculaId, turmaId, disciplinaId])
  @@index([instituicaoId])
  @@index([matriculaId])
  @@index([turmaId])
  @@index([disciplinaId])
  @@index([status])
  @@index([tipoItem])
}

model Modulo {
  id            Int         @id @default(autoincrement())
  nome          String
  ordem         Int
  createdAt     DateTime    @default(now())
  instituicaoId Int
  turmaId       Int
  updatedAt     DateTime    @updatedAt
  aulas         Aula[]
  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  turma         Turma       @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@unique([turmaId, ordem])
  @@index([instituicaoId])
  @@index([turmaId])
}

model Aula {
  id                    Int      @id @default(autoincrement())
  titulo                String
  moduloId              Int?
  createdAt             DateTime @default(now())
  descricao             String?
  duracaoMin            Int?
  instituicaoId         Int
  ordem                 Int
  publicada             Boolean  @default(true)
  turmaId               Int
  disciplinaId          Int?
  substituicaoDocenteId Int?
  updatedAt             DateTime @updatedAt
  videoUrl              String?

  instituicao         Instituicao          @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  modulo              Modulo?              @relation(fields: [moduloId], references: [id])
  turma               Turma                @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  disciplina          Disciplina?          @relation(fields: [disciplinaId], references: [id], onDelete: SetNull)
  substituicaoDocente SubstituicaoDocente? @relation(fields: [substituicaoDocenteId], references: [id], onDelete: SetNull)

  materiais MaterialAula[]
  presencas PresencaAula[]
  progresso ProgressoAula[]

  @@unique([turmaId, disciplinaId, ordem])
  @@index([instituicaoId])
  @@index([turmaId])
  @@index([disciplinaId])
  @@index([substituicaoDocenteId])
  @@index([moduloId])
}

model MaterialAula {
  id            Int          @id @default(autoincrement())
  tipo          MaterialTipo
  titulo        String
  url           String?
  arquivoNome   String?
  mimeType      String?
  tamanho       Int?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  instituicaoId Int
  aulaId        Int
  aula          Aula         @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  instituicao   Instituicao  @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)

  @@index([instituicaoId])
  @@index([aulaId])
}

model ProgressoAula {
  id                     Int         @id @default(autoincrement())
  concluida              Boolean     @default(false)
  concluidaEm            DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  instituicaoId          Int
  alunoId                Int
  aulaId                 Int
  tempoAssistidoSegundos Int         @default(0)
  tempoMinimoSegundos    Int         @default(0)
  aluno                  Aluno       @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  aula                   Aula        @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  instituicao            Instituicao @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)

  @@unique([alunoId, aulaId])
  @@index([instituicaoId])
  @@index([alunoId])
  @@index([aulaId])
}

model Atividade {
  id          Int             @id @default(autoincrement())
  titulo      String
  descricao   String?
  prazo       DateTime?
  notaMaxima  Float           @default(10)
  status      StatusAtividade @default(RASCUNHO)
  publicadaAt DateTime?
  encerradaAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  instituicaoId         Int
  turmaId               Int
  disciplinaId          Int?
  substituicaoDocenteId Int?

  criadoPorId                 Int?
  professorResponsavelId      Int?
  publicadoPorId              Int?
  enviadoParaApoioDocenteEm   DateTime?
  publicadoPeloApoioDocenteEm DateTime?

  instituicao          Instituicao          @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  turma                Turma                @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  disciplina           Disciplina?          @relation(fields: [disciplinaId], references: [id])
  criadoPor            User?                @relation("AtividadeCriadaPor", fields: [criadoPorId], references: [id])
  publicadoPor         User?                @relation("AtividadePublicadaPor", fields: [publicadoPorId], references: [id])
  professorResponsavel Professor?           @relation("AtividadeProfessorResponsavel", fields: [professorResponsavelId], references: [id])
  substituicaoDocente  SubstituicaoDocente? @relation(fields: [substituicaoDocenteId], references: [id], onDelete: SetNull)

  anexos                    AtividadeAnexo[]
  entregas                  EntregaAtividade[]
  notas                     Nota[]
  EntregaAtividadeHistorico EntregaAtividadeHistorico[]

  @@index([instituicaoId])
  @@index([turmaId])
  @@index([disciplinaId])
  @@index([criadoPorId])
  @@index([professorResponsavelId])
  @@index([substituicaoDocenteId])
  @@index([publicadoPorId])
  @@index([status])
  @@index([instituicaoId, status])
  @@index([instituicaoId, turmaId, disciplinaId])
  @@index([instituicaoId, professorResponsavelId])
}

model AtividadeAnexo {
  id          Int      @id @default(autoincrement())
  titulo      String
  url         String
  arquivoNome String?
  mimeType    String?
  tamanho     Int?
  createdAt   DateTime @default(now())

  instituicaoId Int
  atividadeId   Int
  criadoPorId   Int?

  atividade   Atividade   @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  instituicao Instituicao @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  criadoPor   User?       @relation("AtividadeAnexoCriadoPor", fields: [criadoPorId], references: [id])

  @@index([instituicaoId])
  @@index([atividadeId])
  @@index([criadoPorId])
}

model EntregaAtividade {
  id            Int         @id @default(autoincrement())
  texto         String?
  link          String?
  arquivoUrl    String?
  nota          Float?
  feedback      String?
  entregueEm    DateTime    @default(now())
  corrigidaEm   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  instituicaoId Int
  atividadeId   Int
  alunoId       Int
  aluno         Aluno       @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  atividade     Atividade   @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)

  historicos EntregaAtividadeHistorico[]

  @@unique([atividadeId, alunoId])
  @@index([instituicaoId])
  @@index([atividadeId])
  @@index([alunoId])
}

model EntregaAtividadeHistorico {
  id          Int       @id @default(autoincrement())
  texto       String?
  link        String?
  arquivoUrl  String?
  nota        Float?
  feedback    String?
  entregueEm  DateTime?
  corrigidaEm DateTime?
  versao      Int       @default(1)
  createdAt   DateTime  @default(now())

  instituicaoId Int
  atividadeId   Int
  alunoId       Int
  entregaId     Int

  entrega     EntregaAtividade @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  aluno       Aluno            @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  atividade   Atividade        @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  instituicao Instituicao      @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)

  @@index([instituicaoId])
  @@index([atividadeId])
  @@index([alunoId])
  @@index([entregaId])
  @@index([entregaId, versao])
}

model Prova {
  id                    Int         @id @default(autoincrement())
  titulo                String
  notaMaxima            Float       @default(10)
  ativa                 Boolean     @default(true)
  createdAt             DateTime    @default(now())
  descricao             String?
  disponivelEm          DateTime?
  notaDisponivelEm      DateTime?
  mostrarNotaAoFinal    Boolean     @default(false)
  encerradaAt           DateTime?
  expiraEm              DateTime?
  instituicaoId         Int
  publicadaAt           DateTime?
  status                StatusProva @default(RASCUNHO)
  tempoMin              Int?
  tentativasMax         Int         @default(1)
  turmaId               Int
  substituicaoDocenteId Int?
  updatedAt             DateTime    @updatedAt
  notas                 Nota[]
  instituicao           Instituicao @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)

  turma                 Turma                @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  substituicaoDocente   SubstituicaoDocente? @relation(fields: [substituicaoDocenteId], references: [id], onDelete: SetNull)
  tipoPublico           String               @default("TURMA")
  exigirAulasConcluidas Boolean              @default(false)
  alunosLiberados       ProvaAluno[]
  questoes              Questao[]
  tentativas            TentativaProva[]

  @@index([instituicaoId])
  @@index([turmaId])
  @@index([status])
  @@index([instituicaoId, turmaId, status, ativa])
  @@index([substituicaoDocenteId])
  @@index([instituicaoId, tipoPublico])
  @@index([instituicaoId, disponivelEm])
  @@index([instituicaoId, expiraEm])
}

model Questao {
  id             Int             @id @default(autoincrement())
  valor          Float           @default(1)
  provaId        Int
  createdAt      DateTime        @default(now())
  enunciado      String
  instituicaoId  Int
  obrigatoria    Boolean         @default(true)
  ordem          Int             @default(0)
  respostaModelo String?
  updatedAt      DateTime        @updatedAt
  tipo           QuestaoTipo
  alternativas   Alternativa[]
  instituicao    Instituicao     @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  prova          Prova           @relation(fields: [provaId], references: [id], onDelete: Cascade)
  respostas      RespostaProva[]

  @@unique([provaId, ordem])
  @@index([instituicaoId])
  @@index([provaId])
}

model Alternativa {
  id            Int             @id @default(autoincrement())
  texto         String
  correta       Boolean         @default(false)
  questaoId     Int
  instituicaoId Int
  ordem         Int             @default(0)
  instituicao   Instituicao     @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  questao       Questao         @relation(fields: [questaoId], references: [id], onDelete: Cascade)
  respostas     RespostaProva[]

  @@index([instituicaoId])
  @@index([questaoId])
  @@index([questaoId, ordem])
}

model TentativaProva {
  id              Int             @id @default(autoincrement())
  finalizada      Boolean         @default(false)
  createdAt       DateTime        @default(now())
  alunoId         Int
  provaId         Int
  corrigidaEm     DateTime?
  expiraEm        DateTime?
  finishedAt      DateTime?
  instituicaoId   Int
  notaFinal       Float?
  notaObjetiva    Float?
  startedAt       DateTime        @default(now())
  status          StatusTentativa @default(EM_ANDAMENTO)
  tentativaNumero Int             @default(1)
  updatedAt       DateTime        @updatedAt
  respostas       RespostaProva[]
  aluno           Aluno           @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  instituicao     Instituicao     @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  prova           Prova           @relation(fields: [provaId], references: [id], onDelete: Cascade)

  @@unique([alunoId, provaId, tentativaNumero])
  @@index([instituicaoId])
  @@index([alunoId])
  @@index([provaId])
  @@index([status])
  @@index([instituicaoId, alunoId, provaId])
  @@index([instituicaoId, provaId, status])
  @@index([instituicaoId, alunoId, status])
}

model RespostaProva {
  id              Int            @id @default(autoincrement())
  respostaTexto   String?
  correta         Boolean?
  nota            Float?
  feedback        String?
  corrigidaManual Boolean        @default(false)
  corrigidaEm     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  instituicaoId   Int
  tentativaId     Int
  questaoId       Int
  alternativaId   Int?
  alunoId         Int?
  alternativa     Alternativa?   @relation(fields: [alternativaId], references: [id])
  aluno           Aluno?         @relation(fields: [alunoId], references: [id])
  instituicao     Instituicao    @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  questao         Questao        @relation(fields: [questaoId], references: [id], onDelete: Cascade)
  tentativa       TentativaProva @relation(fields: [tentativaId], references: [id], onDelete: Cascade)

  @@unique([tentativaId, questaoId])
  @@index([instituicaoId])
  @@index([tentativaId])
  @@index([questaoId])
  @@index([instituicaoId, tentativaId, questaoId])
  @@index([instituicaoId, alunoId])
  @@index([alternativaId])
}

model Nota {
  id            Int         @id @default(autoincrement())
  alunoId       Int
  valor         Float
  createdAt     DateTime    @default(now())
  turmaId       Int
  atividadeId   Int?
  instituicaoId Int
  observacao    String?
  peso          Float?
  provaId       Int?
  tipo          NotaTipo
  updatedAt     DateTime    @updatedAt
  aluno         Aluno       @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  atividade     Atividade?  @relation(fields: [atividadeId], references: [id])
  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  prova         Prova?      @relation(fields: [provaId], references: [id])
  turma         Turma       @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@index([instituicaoId])
  @@index([alunoId])
  @@index([turmaId])
  @@index([atividadeId])
  @@index([provaId])
  @@index([instituicaoId, alunoId, turmaId])
  @@index([instituicaoId, alunoId, provaId])
  @@index([instituicaoId, turmaId, tipo])
}

model ResultadoFinal {
  id            Int           @id @default(autoincrement())
  media         Float?
  frequencia    Float?
  situacao      SituacaoFinal @default(EM_ANDAMENTO)
  observacao    String?
  fechadoEm     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  instituicaoId Int
  alunoId       Int
  turmaId       Int
  disciplinaId  Int
  aluno         Aluno         @relation(fields: [alunoId], references: [id], onDelete: Cascade)
