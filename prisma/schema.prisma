  RegraComissaoRH                RegraComissaoRH[]
  FuncionarioPlanoComissaoRH     FuncionarioPlanoComissaoRH[]
  MatriculaParticipanteComercial MatriculaParticipanteComercial[]
  LancamentoComissaoRH           LancamentoComissaoRH[]
  equipesComerciais              EquipeComercial[]
  membrosEquipesComerciais       EquipeComercialMembro[]
  metasComerciais                MetaComercial[]
  rematriculasSemestrais         RematriculaSemestral[]
  itensRematriculaSemestral      RematriculaSemestralItem[]

  restricoesRematricula          RestricaoRematriculaAluno[]
  historicosRestricaoRematricula RestricaoRematriculaHistorico[]

  @@index([redeInstitucionalId])
  @@index([redeInstitucionalId, ativo])
}

model RedeInstitucional {
  id                       Int      @id @default(autoincrement())
  nome                     String
  instituicaoContratanteId Int      @unique
  ativo                    Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  instituicaoContratante Instituicao   @relation("RedeInstitucionalContratante", fields: [instituicaoContratanteId], references: [id], onDelete: Restrict)
  instituicoes           Instituicao[] @relation("RedeInstitucionalMembros")

  @@index([ativo])
}

model User {
  id                 Int          @id @default(autoincrement())
  nome               String
  email              String       @unique
  senha              String
  createdAt          DateTime     @default(now())
  instituicaoId      Int
  ativo              Boolean      @default(true)
  updatedAt          DateTime     @updatedAt
  role               Role
  ultimoLoginAt      DateTime?
  aluno              Aluno?
  funcionario        Funcionario?
  professor          Professor?
  resetToken         String?
  resetTokenExpira   DateTime?
  precisaTrocarSenha Boolean      @default(false)
  isMasterAdmin      Boolean      @default(false)
  acessoTodosPolos   Boolean      @default(true)
  instituicao        Instituicao  @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)

  cursosCriados   Curso[]       @relation("CursoCriadoPor")
  cursosExcluidos Curso[]       @relation("CursoExcluidoPor")
  CreditoIA       CreditoIA?
  notificacoes    Notificacao[]

  autorizacoesCorrecaoPontoRH AutorizacaoCorrecaoPontoRH[] @relation("AutorizacaoCorrecaoPontoRHAutorizadoPor")

  cancelamentosCorrecaoPontoRH AutorizacaoCorrecaoPontoRH[] @relation("AutorizacaoCorrecaoPontoRHCanceladoPor")

  solicitacoesCorrecaoPontoRHAplicadas SolicitacaoCorrecaoPontoRH[] @relation("SolicitacaoCorrecaoPontoRHAplicadoPor")

  avisosWhatsappCorrecaoPontoRHDestinatario AvisoWhatsappCorrecaoPontoRH[] @relation("AvisoWhatsappCorrecaoPontoRHDestinatario")

  reunioesCriadas         Reuniao[]             @relation("ReuniaoCriadaPor")
  reunioesParticipante    ReuniaoParticipante[]
  documentosRHCriados     DocumentoRH[]         @relation("DocumentoRHCriadoPor")
  documentosRHArquivados  DocumentoRH[]         @relation("DocumentoRHArquivadoPor")
  documentosRHRestaurados DocumentoRH[]         @relation("DocumentoRHRestauradoPor")
  ocorrenciasRHCriadas    OcorrenciaRH[]        @relation("OcorrenciaRHCriadoPor")
  ocorrenciasRHArquivadas OcorrenciaRH[]        @relation("OcorrenciaRHArquivadaPor")
  atividadesCriadas       Atividade[]           @relation("AtividadeCriadaPor")
  atividadesPublicadas    Atividade[]           @relation("AtividadePublicadaPor")
  anexosAtividadeCriados  AtividadeAnexo[]      @relation("AtividadeAnexoCriadoPor")
  crachaModelosCriados    CrachaModelo[]        @relation("CrachaModeloCriadoPor")

  feriasRHCriadas         FeriasRH[]               @relation("FeriasRHCriadoPor")
  feriasRHArquivadas      FeriasRH[]               @relation("FeriasRHArquivadaPor")
  feriasRHRestauradas     FeriasRH[]               @relation("FeriasRHRestauradoPor")
  alteracoesRemuneracaoRH HistoricoRemuneracaoRH[] @relation("HistoricoRemuneracaoRHAlteradoPor")

  examesRHCriados     ExameMedicoRH[] @relation("ExameMedicoRHCriadoPor")
  examesRHArquivados  ExameMedicoRH[] @relation("ExameMedicoRHArquivadoPor")
  examesRHRestaurados ExameMedicoRH[] @relation("ExameMedicoRHRestauradoPor")

  rescisoesRHCriadas     RescisaoRH[] @relation("RescisaoRHCriadoPor")
  rescisoesRHArquivadas  RescisaoRH[] @relation("RescisaoRHArquivadaPor")
  rescisoesRHRestauradas RescisaoRH[] @relation("RescisaoRHRestauradoPor")

  holeritesRHCriados    HoleriteRH[] @relation("HoleriteRHCriadoPor")
  holeritesRHArquivados HoleriteRH[] @relation("HoleriteRHArquivadoPor")
  holeritesRHPagos      HoleriteRH[] @relation("HoleriteRHPagoPor")

  pagamentosHoleriteRHRegistrados                  PagamentoHoleriteRH[]               @relation("PagamentoHoleriteRHRegistradoPor")
  pagamentosHoleriteRHConfirmados                  PagamentoHoleriteRH[]               @relation("PagamentoHoleriteRHConfirmadoPor")
  pagamentosHoleriteRHContestados                  PagamentoHoleriteRH[]               @relation("PagamentoHoleriteRHContestadoPor")
  pagamentosHoleriteRHCancelados                   PagamentoHoleriteRH[]               @relation("PagamentoHoleriteRHCanceladoPor")
  pagamentosHoleriteRHAssinadosPeloRh              PagamentoHoleriteRH[]               @relation("PagamentoHoleriteRHAssinadoPeloRh")
  documentosAssinadosManualmenteHoleriteRHEnviados DocumentoAssinadoManualHoleriteRH[] @relation("DocumentoAssinadoManualHoleriteRHEnviadoPor")

  documentosProfessorCriados     DocumentoProfessor[]           @relation("DocumentoProfessorCriadoPor")
  documentosProfessorArquivados  DocumentoProfessor[]           @relation("DocumentoProfessorArquivadoPor")
  documentosProfessorRestaurados DocumentoProfessor[]           @relation("DocumentoProfessorRestauradoPor")
  preferenciasAgendaOperacional  PreferenciaAgendaOperacional[]
  visitantesCriados              Visitante[]                    @relation("VisitanteCriadoPor")
  ajustesMarcacaoPontoRHCriados  AjusteMarcacaoPontoRH[]        @relation("AjusteMarcacaoPontoRHCriadoPor")

  certificadoModelosCriados    CertificadoModelo[] @relation("CertificadoModeloCriadoPor")
  certificadoModelosPublicados CertificadoModelo[] @relation("CertificadoModeloPublicadoPor")

  planosComissaoRHCriados               PlanoComissaoRH[]                @relation("PlanoComissaoRHCriadoPor")
  regrasComissaoRHCriadas               RegraComissaoRH[]                @relation("RegraComissaoRHCriadoPor")
  funcionariosPlanosComissaoRHCriados   FuncionarioPlanoComissaoRH[]     @relation("FuncionarioPlanoComissaoRHCriadoPor")
  participantesComerciaisCriados        MatriculaParticipanteComercial[] @relation("MatriculaParticipanteComercialCriadoPor")
  lancamentosComissaoRHCriados          LancamentoComissaoRH[]           @relation("LancamentoComissaoRHCriadoPor")
  lancamentosComissaoRHAprovados        LancamentoComissaoRH[]           @relation("LancamentoComissaoRHAprovadoPor")
  lancamentosComissaoRHReprovados       LancamentoComissaoRH[]           @relation("LancamentoComissaoRHReprovadoPor")
  lancamentosComissaoRHEnviadosHolerite LancamentoComissaoRH[]           @relation("LancamentoComissaoRHEnviadoHoleritePor")
  lancamentosComissaoRHEstornados       LancamentoComissaoRH[]           @relation("LancamentoComissaoRHEstornadoPor")
  leadsCriados                          Lead[]                           @relation("LeadCriadoPor")
  leadsAtualizados                      Lead[]                           @relation("LeadAtualizadoPor")
  interacoesLeadCriadas                 LeadInteracao[]                  @relation("LeadInteracaoCriadaPor")
  equipesComerciaisCriadas              EquipeComercial[]                @relation("EquipeComercialCriadaPor")
  equipesComerciaisAtualizadas          EquipeComercial[]                @relation("EquipeComercialAtualizadaPor")
  membrosEquipesComerciaisCriados       EquipeComercialMembro[]          @relation("EquipeComercialMembroCriadoPor")
  membrosEquipesComerciaisAtualizados   EquipeComercialMembro[]          @relation("EquipeComercialMembroAtualizadoPor")
  metasComerciaisCriadas                MetaComercial[]                  @relation("MetaComercialCriadaPor")
  metasComerciaisAtualizadas            MetaComercial[]                  @relation("MetaComercialAtualizadaPor")

  programasRemuneracaoVariavelRHCriados                ProgramaRemuneracaoVariavelRH[]             @relation("ProgramaRemuneracaoVariavelRHCriadoPor")
  programasRemuneracaoVariavelRHAprovados              ProgramaRemuneracaoVariavelRH[]             @relation("ProgramaRemuneracaoVariavelRHAprovadoPor")
  participantesProgramasRemuneracaoVariavelRHIncluidos ParticipanteProgramaRemuneracaoVariavelRH[] @relation("ParticipanteProgramaRemuneracaoVariavelRHIncluidoPor")
  lancamentosRemuneracaoVariavelRHCriados              LancamentoRemuneracaoVariavelRH[]           @relation("LancamentoRemuneracaoVariavelRHCriadoPor")
  lancamentosRemuneracaoVariavelRHAprovados            LancamentoRemuneracaoVariavelRH[]           @relation("LancamentoRemuneracaoVariavelRHAprovadoPor")
  lancamentosRemuneracaoVariavelRHReprovados           LancamentoRemuneracaoVariavelRH[]           @relation("LancamentoRemuneracaoVariavelRHReprovadoPor")
  lancamentosRemuneracaoVariavelRHEnviadosHolerite     LancamentoRemuneracaoVariavelRH[]           @relation("LancamentoRemuneracaoVariavelRHEnviadoHoleritePor")
  lancamentosRemuneracaoVariavelRHEstornados           LancamentoRemuneracaoVariavelRH[]           @relation("LancamentoRemuneracaoVariavelRHEstornadoPor")
  impersonacoesComoMaster                              ImpersonacaoSuporte[]                       @relation("ImpersonacaoSuporteMaster")
  impersonacoesComoAlvo                                ImpersonacaoSuporte[]                       @relation("ImpersonacaoSuporteAlvo")
  rematriculasAnalisadas                               RematriculaSemestral[]                      @relation("RematriculaAnalisadaPor")

  acessosPolos          UserPolo[] @relation("UserPoloUsuario")
  acessosPolosCriados   UserPolo[] @relation("UserPoloCriadoPor")
  acessosPolosRevogados UserPolo[] @relation("UserPoloRevogadoPor")
  polosCriados          Polo[]     @relation("PoloCriadoPor")
  polosAtivados         Polo[]     @relation("PoloAtivadoPor")
  polosSuspensos        Polo[]     @relation("PoloSuspensoPor")
  polosEncerrados       Polo[]     @relation("PoloEncerradoPor")

  acessosInstitucionais          UserInstituicaoAcesso[] @relation("UserInstituicaoAcessoUsuario")
  acessosInstitucionaisCriados   UserInstituicaoAcesso[] @relation("UserInstituicaoAcessoCriadoPor")
  acessosInstitucionaisRevogados UserInstituicaoAcesso[] @relation("UserInstituicaoAcessoRevogadoPor")

  restricoesRematriculaAplicadas   RestricaoRematriculaAluno[]     @relation("RestricaoRematriculaAplicadaPor")
  restricoesRematriculaRemovidas   RestricaoRematriculaAluno[]     @relation("RestricaoRematriculaRemovidaPor")
  historicosRestricaoRematricula   RestricaoRematriculaHistorico[] @relation("RestricaoRematriculaHistoricoRealizadoPor")
  matriculasConfirmacaoMenor       Matricula[]                     @relation("MatriculaConfirmacaoMenorPorUser")
  publicacoesCursosRedeCriadas     CursoPublicacaoRede[]           @relation("CursoPublicacaoPublicadoPor")
  publicacoesCursosRedeAtualizadas CursoPublicacaoRede[]           @relation("CursoPublicacaoAtualizadoPor")
  publicacoesCursosRedeRetiradas   CursoPublicacaoRede[]           @relation("CursoPublicacaoRetiradoPor")

  @@index([instituicaoId])
  @@index([role])
  @@index([instituicaoId, acessoTodosPolos])
}

model UserInstituicaoAcesso {
  id              Int                    @id @default(autoincrement())
  userId          Int
  instituicaoId   Int
  nivelAcesso     NivelAcessoInstituicao @default(LEITURA)
  ativo           Boolean                @default(true)
  criadoPorId     Int?
  revogadoPorId   Int?
  criadoEm        DateTime               @default(now())
  atualizadoEm    DateTime               @updatedAt
  revogadoEm      DateTime?
  motivoRevogacao String?                @db.Text

  user        User        @relation("UserInstituicaoAcessoUsuario", fields: [userId], references: [id], onDelete: Cascade)
  instituicao Instituicao @relation("UserInstituicaoAcessoDestino", fields: [instituicaoId], references: [id], onDelete: Cascade)
  criadoPor   User?       @relation("UserInstituicaoAcessoCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  revogadoPor User?       @relation("UserInstituicaoAcessoRevogadoPor", fields: [revogadoPorId], references: [id], onDelete: SetNull)

  @@unique([userId, instituicaoId])
  @@index([userId])
  @@index([instituicaoId])
  @@index([instituicaoId, ativo])
  @@index([criadoPorId])
  @@index([revogadoPorId])
}

model ImpersonacaoSuporte {
  id Int @id @default(autoincrement())

  masterUserId  Int?
  usuarioAlvoId Int?
  instituicaoId Int?

  masterEmailSnapshot      String
  usuarioAlvoEmailSnapshot String
  usuarioAlvoNomeSnapshot  String
  instituicaoNomeSnapshot  String

  motivo String @db.Text
  portal String

  iniciadoEm  DateTime  @default(now())
  expiraEm    DateTime
  encerradoEm DateTime?

  ativa Boolean @default(true)

  ip        String?
  userAgent String? @db.Text

  masterUser User? @relation("ImpersonacaoSuporteMaster", fields: [masterUserId], references: [id], onDelete: SetNull)

  usuarioAlvo User? @relation("ImpersonacaoSuporteAlvo", fields: [usuarioAlvoId], references: [id], onDelete: SetNull)

  instituicao Instituicao? @relation(fields: [instituicaoId], references: [id], onDelete: SetNull)

  @@index([masterUserId, iniciadoEm])
  @@index([usuarioAlvoId, iniciadoEm])
  @@index([instituicaoId])
  @@index([ativa, expiraEm])
}

model Aluno {
  id                           Int                         @id @default(autoincrement())
  nome                         String
  createdAt                    DateTime                    @default(now())
  instituicaoId                Int
  userId                       Int                         @unique
  ativo                        Boolean                     @default(true)
  matricula                    String?
  updatedAt                    DateTime                    @updatedAt
  bairro                       String?
  cep                          String?
  cidade                       String?
  complemento                  String?
  cpf                          String?
  dataNascimento               DateTime?
  documentoUrl                 String?
  endereco                     String?
  estado                       String?
  numero                       String?
  rg                           String?
  slug                         String?
  telefone                     String?
  cpfResponsavel               String?
  emailResponsavel             String?
  nomeResponsavel              String?
  fotoPerfil                   String?
  parentescoResponsavel        String?
  telefoneResponsavel          String?
  statusAluno                  StatusAluno                 @default(ATIVO)
  descricaoNecessidadeEspecial String?
  observacoesAcessibilidade    String?
  possuiNecessidadeEspecial    Boolean                     @default(false)
  genero                       String?
  nomeSocial                   String?
  poloId                       Int?
  recebeMensagemAniversario    Boolean                     @default(true)
  recebeWhatsappAniversario    Boolean                     @default(true)
  instituicao                  Instituicao                 @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  polo                         Polo?                       @relation(fields: [poloId], references: [id])
  user                         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  atestadosMedicos             AtestadoMedico[]
  certificados                 Certificado[]
  cobrancas                    Cobranca[]
  contratos                    Contrato[]
  documentos                   DocumentoAluno[]
  DocumentoGerado              DocumentoGerado[]
  entregas                     EntregaAtividade[]
  lancamentosFinanceiros       LancamentoFinanceiro[]
  matriculas                   Matricula[]
  movimentosCaixa              MovimentoCaixa[]
  notas                        Nota[]
  pagamentos                   Pagamento[]
  presencasAula                PresencaAula[]
  progresso                    ProgressoAula[]
  respostas                    RespostaProva[]
