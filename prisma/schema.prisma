generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Instituicao {
  id                     Int      @id @default(autoincrement())
  nome                   String
  ativo                  Boolean  @default(true)
  createdAt              DateTime @default(now())
  proximoNumeroMatricula Int      @default(1)
  dominio                String?  @unique
  slug                   String   @unique
  updatedAt              DateTime
  plano                  String   @default("ESSENCIAL")
  statusAssinatura       String   @default("ATIVA")

  metaAccessToken     String?
  metaConectado       Boolean @default(false)
  metaPageId          String?
  metaPageName        String?
  metaPageAccessToken String?
  usaControlePonto    Boolean @default(false)
  usaBancoHoras       Boolean @default(true)

  googleAnalyticsId          String?
  googleAnalyticsPropertyId  String?
  googleAnalyticsAtivo       Boolean @default(false)
  googleTagManagerId         String?
  googleTagManagerAtivo      Boolean @default(false)
  googleAdsId                String?
  googleAdsAtivo             Boolean @default(false)
  googleAdsCustomerId        String?
  googleAdsRefreshToken      String?
  googleAdsAccountName       String?
  searchConsoleDominio       String?
  searchConsoleAtivo         Boolean @default(false)
  googleBusinessUrl          String?
  googleBusinessAtivo        Boolean @default(false)
  googleBusinessRefreshToken String?
  googleBusinessAccountId    String?
  googleBusinessLocationId   String?
  googleBusinessName         String?
  googleSearchConsoleMeta    String?
  responsavelRH              String?
  emailRH                    String?
  telefoneRH                 String?

  googleSearchConsoleAtivo Boolean @default(false)

  aniversariantesAtivo Boolean @default(true)

  aniversarioTituloPadrao   String?
  aniversarioMensagemPadrao String? @db.Text

  aniversarioEnviarChatPadrao     Boolean @default(true)
  aniversarioEnviarWhatsappPadrao Boolean @default(false)

  alternativas               Alternativa[]
  ouvidoriasPhanyx           OuvidoriaPhanyx[]
  alunos                     Aluno[]
  atestadosMedicos           AtestadoMedico[]
  atividades                 Atividade[]
  anexosAtividade            AtividadeAnexo[]
  aulas                      Aula[]
  caixas                     Caixa[]
  certificados               Certificado[]
  cobrancas                  Cobranca[]
  configuracaoInstituicao    ConfiguracaoInstituicao?
  contratos                  Contrato[]
  cursos                     Curso[]
  cursoSemestres             CursoSemestre[]
  cursoSemestreDisciplinas   CursoSemestreDisciplina[]
  Departamento               Departamento[]
  disciplinas                Disciplina[]
  documentosAlunos           DocumentoAluno[]
  documentosGerados          DocumentoGerado[]
  documentoTemplates         DocumentoTemplate[]
  entregas                   EntregaAtividade[]
  Funcionario                Funcionario[]
  itensMatricula             ItemMatricula[]
  lancamentosFinanceiros     LancamentoFinanceiro[]
  materiaisAula              MaterialAula[]
  matriculas                 Matricula[]
  modulos                    Modulo[]
  movimentosCaixa            MovimentoCaixa[]
  notas                      Nota[]
  pagamentos                 Pagamento[]
  presencasAula              PresencaAula[]
  professores                Professor[]
  progressoAulas             ProgressoAula[]
  provas                     Prova[]
  questoes                   Questao[]
  respostas                  RespostaProva[]
  resultadosFinais           ResultadoFinal[]
  tentativas                 TentativaProva[]
  turmas                     Turma[]
  usuarios                   User[]
  polos                      Polo[]
  adesoes                    AdesaoInstituicao[]
  assinaturaPhanyx           AssinaturaPhanyx?
  TurmaDisciplina            TurmaDisciplina[]
  certificadoCampos          CertificadoCampo[]
  certificadoModelos         CertificadoModelo[]
  periodosMatricula          PeriodoMatricula[]
  disciplinaPreRequisitos    DisciplinaPreRequisito[]
  cursosDisciplinasExtras    CursoDisciplinaExtraPermitida[]
  certificadoTemplateUrl     String?
  certificadoPreviewUrl      String?
  certificadoTextoPadrao     String?
  certificadoAssinaturaUrl   String?
  certificadoCoordenadorNome String?
  certificadoCidade          String?

  certificadoModoFundo      String @default("modelo") // modelo | phanyx | cor
  certificadoCorFundoPagina String @default("#ffffff")
  certificadoTamanhoPapel   String @default("A4") // A5 | A4 | A3
  certificadoOrientacao     String @default("paisagem") // paisagem | retrato
  certificadoLarguraBase    Int    @default(1123)
  certificadoAlturaBase     Int    @default(794)

  cursosPolos             CursoPolo[]
  professoresDisciplinas  ProfessorDisciplina[]
  turmaSemestres          TurmaSemestre[]
  turmaDisciplinaHorarios TurmaDisciplinaHorario[]
  ouvidorias              Ouvidoria[]
  reunioes                Reuniao[]

  documentosRH                                DocumentoRH[]
  feriasRH                                    FeriasRH[]
  examesRH                                    ExameMedicoRH[]
  rescisoesRH                                 RescisaoRH[]
  holeritesRH                                 HoleriteRH[]
  pontosRH                                    PontoFuncionarioRH[]
  autorizacoesCorrecaoPontoRH                 AutorizacaoCorrecaoPontoRH[]
  solicitacoesCorrecaoPontoRH                 SolicitacaoCorrecaoPontoRH[]
  itensCorrecaoPontoRH                        SolicitacaoCorrecaoPontoItemRH[]
  avisosWhatsappCorrecaoPontoRH               AvisoWhatsappCorrecaoPontoRH[]
  historicosRH                                HistoricoRH[]
  ocorrenciasRH                               OcorrenciaRH[]
  escalasRH                                   EscalaTrabalhoRH[]
  bancoHorasRH                                BancoHorasRH[]
  integracoesPontoRH                          IntegracaoPontoRH[]
  configuracaoPontoMobile                     ConfiguracaoPontoMobileRH?
  locaisPontoMobile                           LocalPontoMobileRH[]
  marcacoesPontoMobile                        MarcacaoPontoMobileRH[]
  ajustesMarcacaoPontoRH                      AjusteMarcacaoPontoRH[]
  eventosFolhaRH                              EventoFolhaRH[]
  beneficiosRH                                BeneficioRH[]
  funcionariosBeneficiosRH                    FuncionarioBeneficioRH[]
  programasRemuneracaoVariavelRH              ProgramaRemuneracaoVariavelRH[]
  participantesProgramasRemuneracaoVariavelRH ParticipanteProgramaRemuneracaoVariavelRH[]
  lancamentosRemuneracaoVariavelRH            LancamentoRemuneracaoVariavelRH[]
  configuracoesPortais                        ConfiguracaoPortalInstituicao[]
  isentaPagamento                             Boolean                                     @default(false)
  motivoIsencao                               String?
  EntregaAtividadeHistorico                   EntregaAtividadeHistorico[]
  documentosProfessor                         DocumentoProfessor[]
  notificacoes                                Notificacao[]
  substituicoesDocentes                       SubstituicaoDocente[]
  preferenciasAgendaOperacional               PreferenciaAgendaOperacional[]
  crachaModelos                               CrachaModelo[]
  crachasEmitidos                             CrachaEmitido[]
  CrachaLoteEmissao                           CrachaLoteEmissao[]
  visitantes                                  Visitante[]

  regraLiberacaoCertificado      String                           @default("CURSO_COMPLETO")
  mediaMinimaCertificado         Float                            @default(7)
  frequenciaMinimaCertificado    Float                            @default(75)
  liberarCertificadoAutomatico   Boolean                          @default(true)
  PlanoComissaoRH                PlanoComissaoRH[]
  RegraComissaoRH                RegraComissaoRH[]
  FuncionarioPlanoComissaoRH     FuncionarioPlanoComissaoRH[]
  MatriculaParticipanteComercial MatriculaParticipanteComercial[]
  LancamentoComissaoRH           LancamentoComissaoRH[]
}

model User {
  id                 Int          @id @default(autoincrement())
  nome               String
  email              String       @unique
  senha              String
  createdAt          DateTime     @default(now())
  instituicaoId      Int
  ativo              Boolean      @default(true)
  updatedAt          DateTime     @updatedAt
  role               Role
  ultimoLoginAt      DateTime?
  aluno              Aluno?
  funcionario        Funcionario?
  professor          Professor?
  resetToken         String?
  resetTokenExpira   DateTime?
  precisaTrocarSenha Boolean      @default(false)
  isMasterAdmin      Boolean      @default(false)
  instituicao        Instituicao  @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)

  cursosCriados   Curso[]       @relation("CursoCriadoPor")
  cursosExcluidos Curso[]       @relation("CursoExcluidoPor")
  CreditoIA       CreditoIA?
  notificacoes    Notificacao[]

  autorizacoesCorrecaoPontoRH AutorizacaoCorrecaoPontoRH[] @relation("AutorizacaoCorrecaoPontoRHAutorizadoPor")

  cancelamentosCorrecaoPontoRH AutorizacaoCorrecaoPontoRH[] @relation("AutorizacaoCorrecaoPontoRHCanceladoPor")

  solicitacoesCorrecaoPontoRHAplicadas SolicitacaoCorrecaoPontoRH[] @relation("SolicitacaoCorrecaoPontoRHAplicadoPor")

  avisosWhatsappCorrecaoPontoRHDestinatario AvisoWhatsappCorrecaoPontoRH[] @relation("AvisoWhatsappCorrecaoPontoRHDestinatario")

  reunioesCriadas         Reuniao[]             @relation("ReuniaoCriadaPor")
  reunioesParticipante    ReuniaoParticipante[]
  documentosRHCriados     DocumentoRH[]         @relation("DocumentoRHCriadoPor")
  documentosRHArquivados  DocumentoRH[]         @relation("DocumentoRHArquivadoPor")
  documentosRHRestaurados DocumentoRH[]         @relation("DocumentoRHRestauradoPor")
  ocorrenciasRHCriadas    OcorrenciaRH[]        @relation("OcorrenciaRHCriadoPor")
  ocorrenciasRHArquivadas OcorrenciaRH[]        @relation("OcorrenciaRHArquivadaPor")
  atividadesCriadas       Atividade[]           @relation("AtividadeCriadaPor")
  atividadesPublicadas    Atividade[]           @relation("AtividadePublicadaPor")
  anexosAtividadeCriados  AtividadeAnexo[]      @relation("AtividadeAnexoCriadoPor")
  crachaModelosCriados    CrachaModelo[]        @relation("CrachaModeloCriadoPor")

  feriasRHCriadas     FeriasRH[] @relation("FeriasRHCriadoPor")
  feriasRHArquivadas  FeriasRH[] @relation("FeriasRHArquivadaPor")
  feriasRHRestauradas FeriasRH[] @relation("FeriasRHRestauradoPor")

  examesRHCriados     ExameMedicoRH[] @relation("ExameMedicoRHCriadoPor")
  examesRHArquivados  ExameMedicoRH[] @relation("ExameMedicoRHArquivadoPor")
  examesRHRestaurados ExameMedicoRH[] @relation("ExameMedicoRHRestauradoPor")

  rescisoesRHCriadas     RescisaoRH[] @relation("RescisaoRHCriadoPor")
  rescisoesRHArquivadas  RescisaoRH[] @relation("RescisaoRHArquivadaPor")
  rescisoesRHRestauradas RescisaoRH[] @relation("RescisaoRHRestauradoPor")

  holeritesRHCriados    HoleriteRH[] @relation("HoleriteRHCriadoPor")
  holeritesRHArquivados HoleriteRH[] @relation("HoleriteRHArquivadoPor")

  documentosProfessorCriados     DocumentoProfessor[]           @relation("DocumentoProfessorCriadoPor")
  documentosProfessorArquivados  DocumentoProfessor[]           @relation("DocumentoProfessorArquivadoPor")
  documentosProfessorRestaurados DocumentoProfessor[]           @relation("DocumentoProfessorRestauradoPor")
  preferenciasAgendaOperacional  PreferenciaAgendaOperacional[]
  visitantesCriados              Visitante[]                    @relation("VisitanteCriadoPor")
  ajustesMarcacaoPontoRHCriados  AjusteMarcacaoPontoRH[]        @relation("AjusteMarcacaoPontoRHCriadoPor")

  certificadoModelosCriados    CertificadoModelo[] @relation("CertificadoModeloCriadoPor")
  certificadoModelosPublicados CertificadoModelo[] @relation("CertificadoModeloPublicadoPor")

  planosComissaoRHCriados             PlanoComissaoRH[]                @relation("PlanoComissaoRHCriadoPor")
  regrasComissaoRHCriadas             RegraComissaoRH[]                @relation("RegraComissaoRHCriadoPor")
  funcionariosPlanosComissaoRHCriados FuncionarioPlanoComissaoRH[]     @relation("FuncionarioPlanoComissaoRHCriadoPor")
  participantesComerciaisCriados      MatriculaParticipanteComercial[] @relation("MatriculaParticipanteComercialCriadoPor")
  lancamentosComissaoRHCriados        LancamentoComissaoRH[]           @relation("LancamentoComissaoRHCriadoPor")
  lancamentosComissaoRHAprovados      LancamentoComissaoRH[]           @relation("LancamentoComissaoRHAprovadoPor")
  lancamentosComissaoRHReprovados     LancamentoComissaoRH[]           @relation("LancamentoComissaoRHReprovadoPor")
  lancamentosComissaoRHEstornados     LancamentoComissaoRH[]           @relation("LancamentoComissaoRHEstornadoPor")

  programasRemuneracaoVariavelRHCriados                ProgramaRemuneracaoVariavelRH[]             @relation("ProgramaRemuneracaoVariavelRHCriadoPor")
  programasRemuneracaoVariavelRHAprovados              ProgramaRemuneracaoVariavelRH[]             @relation("ProgramaRemuneracaoVariavelRHAprovadoPor")
  participantesProgramasRemuneracaoVariavelRHIncluidos ParticipanteProgramaRemuneracaoVariavelRH[] @relation("ParticipanteProgramaRemuneracaoVariavelRHIncluidoPor")
  lancamentosRemuneracaoVariavelRHCriados              LancamentoRemuneracaoVariavelRH[]           @relation("LancamentoRemuneracaoVariavelRHCriadoPor")
  lancamentosRemuneracaoVariavelRHAprovados            LancamentoRemuneracaoVariavelRH[]           @relation("LancamentoRemuneracaoVariavelRHAprovadoPor")
  lancamentosRemuneracaoVariavelRHReprovados           LancamentoRemuneracaoVariavelRH[]           @relation("LancamentoRemuneracaoVariavelRHReprovadoPor")
  lancamentosRemuneracaoVariavelRHEnviadosHolerite     LancamentoRemuneracaoVariavelRH[]           @relation("LancamentoRemuneracaoVariavelRHEnviadoHoleritePor")
  lancamentosRemuneracaoVariavelRHEstornados           LancamentoRemuneracaoVariavelRH[]           @relation("LancamentoRemuneracaoVariavelRHEstornadoPor")

  @@index([instituicaoId])
  @@index([role])
}

model Aluno {
  id                           Int                         @id @default(autoincrement())
  nome                         String
  createdAt                    DateTime                    @default(now())
  instituicaoId                Int
  userId                       Int                         @unique
  ativo                        Boolean                     @default(true)
  matricula                    String?
  updatedAt                    DateTime                    @updatedAt
  bairro                       String?
  cep                          String?
  cidade                       String?
  complemento                  String?
  cpf                          String?
  dataNascimento               DateTime?
  documentoUrl                 String?
  endereco                     String?
  estado                       String?
  numero                       String?
  rg                           String?
  slug                         String?
  telefone                     String?
  cpfResponsavel               String?
  emailResponsavel             String?
  nomeResponsavel              String?
  fotoPerfil                   String?
  parentescoResponsavel        String?
  telefoneResponsavel          String?
  statusAluno                  StatusAluno                 @default(ATIVO)
  descricaoNecessidadeEspecial String?
  observacoesAcessibilidade    String?
  possuiNecessidadeEspecial    Boolean                     @default(false)
  genero                       String?
  nomeSocial                   String?
  poloId                       Int?
  recebeMensagemAniversario    Boolean                     @default(true)
  recebeWhatsappAniversario    Boolean                     @default(true)
  instituicao                  Instituicao                 @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  polo                         Polo?                       @relation(fields: [poloId], references: [id])
  user                         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  atestadosMedicos             AtestadoMedico[]
  certificados                 Certificado[]
  cobrancas                    Cobranca[]
  contratos                    Contrato[]
  documentos                   DocumentoAluno[]
  DocumentoGerado              DocumentoGerado[]
  entregas                     EntregaAtividade[]
  lancamentosFinanceiros       LancamentoFinanceiro[]
  matriculas                   Matricula[]
  movimentosCaixa              MovimentoCaixa[]
  notas                        Nota[]
  pagamentos                   Pagamento[]
  presencasAula                PresencaAula[]
  progresso                    ProgressoAula[]
  respostas                    RespostaProva[]
  resultadosFinais             ResultadoFinal[]
  tentativas                   TentativaProva[]
  reunioesParticipante         ReuniaoParticipante[]
  provasLiberadas              ProvaAluno[]
  EntregaAtividadeHistorico    EntregaAtividadeHistorico[]

  @@unique([instituicaoId, matricula])
  @@unique([instituicaoId, slug])
  @@index([instituicaoId])
  @@index([nome])
  @@index([cpf])
  @@index([statusAluno])
  @@index([poloId])
}

model Professor {
  id                Int         @id @default(autoincrement())
  nome              String
  createdAt         DateTime    @default(now())
  instituicaoId     Int
  userId            Int         @unique
  ativo             Boolean     @default(true)
  updatedAt         DateTime    @updatedAt
  codigoFuncionario String?
  cpf               String?
  dataNascimento    DateTime?
  documentoUrl      String?
  especialidade     String?
  formacao          String?
  fotoPerfil        String?
  miniBio           String?
  rg                String?
  slug              String?
  telefone          String?
  titulacao         String?
  instituicao       Instituicao @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  statusProfessor String  @default("ATIVO")
  motivoStatus    String?

  recebeMensagemAniversario Boolean @default(true)
  recebeWhatsappAniversario Boolean @default(true)

  departamentoId Int?
  departamento   Departamento? @relation(fields: [departamentoId], references: [id])

  turmas                      Turma[]
  turmaDisciplinas            TurmaDisciplina[]
  disciplinasPadrao           Disciplina[]
  disciplinasHabilitadas      ProfessorDisciplina[]
  poloId                      Int?
  polo                        Polo?                 @relation(fields: [poloId], references: [id])
  reunioesCriadas             Reuniao[]             @relation("ReuniaoProfessor")
  atividadesResponsavel       Atividade[]           @relation("AtividadeProfessorResponsavel")
  documentosProfessor         DocumentoProfessor[]
  substituicoesComoTitular    SubstituicaoDocente[] @relation("ProfessorTitularSubstituicao")
  substituicoesComoSubstituto SubstituicaoDocente[] @relation("ProfessorSubstitutoSubstituicao")

  @@unique([instituicaoId, slug])
  @@index([instituicaoId])
  @@index([nome])
  @@index([cpf])
  @@index([poloId])
  @@index([departamentoId])
}

model Curso {
  id                         Int                   @id @default(autoincrement())
  nome                       String
  descricao                  String?
  ativo                      Boolean               @default(true)
  createdAt                  DateTime              @default(now())
  instituicaoId              Int
  codigo                     String?
  updatedAt                  DateTime              @updatedAt
  quantidadeParcelas         Int?
  valorMatricula             Float?
  valorMensalidade           Float?
  quantidadeSemestres        Int?
  cargaHorariaMaximaSemestre Int?
  excluidoEm                 DateTime?
  expiraExclusaoEm           DateTime?
  modalidadeCertificado      ModalidadeCertificado @default(GERAL)
  certificadoModeloId        Int?
  criadoPorId                Int?
  excluidoPorId              Int?
  criadoPor                  User?                 @relation("CursoCriadoPor", fields: [criadoPorId], references: [id])
  excluidoPor                User?                 @relation("CursoExcluidoPor", fields: [excluidoPorId], references: [id])
  instituicao                Instituicao           @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  certificadoModelo          CertificadoModelo?    @relation(fields: [certificadoModeloId], references: [id], onDelete: SetNull)

  semestres                   CursoSemestre[]
  disciplinas                 Disciplina[]
  documentosGerados           DocumentoGerado[]
  matriculas                  Matricula[]
  turmas                      Turma[]
  periodosMatricula           PeriodoMatricula[]
  disciplinasExtrasPermitidas CursoDisciplinaExtraPermitida[]
  cursosPolos                 CursoPolo[]
  reunioes                    Reuniao[]
  regrasComissaoRH            RegraComissaoRH[]

  @@unique([instituicaoId, nome])
  @@unique([instituicaoId, codigo])
  @@index([instituicaoId])
  @@index([certificadoModeloId])
  @@index([instituicaoId, modalidadeCertificado])
}

model CursoSemestre {
  id            Int                       @id @default(autoincrement())
  numero        Int
  titulo        String?
  descricao     String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  instituicaoId Int
  cursoId       Int
  cargaMaxima   Int?
  cargaMinima   Int?
  curso         Curso                     @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  instituicao   Instituicao               @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  disciplinas   CursoSemestreDisciplina[]
  matriculas    Matricula[]

  @@unique([cursoId, numero])
  @@index([instituicaoId])
  @@index([cursoId])
}

model CursoSemestreDisciplina {
  id              Int           @id @default(autoincrement())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  instituicaoId   Int
  cursoSemestreId Int
  disciplinaId    Int
  cursoSemestre   CursoSemestre @relation(fields: [cursoSemestreId], references: [id], onDelete: Cascade)
  disciplina      Disciplina    @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  instituicao     Instituicao   @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)

  @@unique([cursoSemestreId, disciplinaId])
  @@index([instituicaoId])
  @@index([cursoSemestreId])
  @@index([disciplinaId])
}

model Pagamento {
  id             Int                  @id @default(autoincrement())
  valorPago      Float
  pagoEm         DateTime             @default(now())
  formaPagamento FormaPagamento?
  observacao     String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  instituicaoId  Int
  alunoId        Int
  lancamentoId   Int
  aluno          Aluno                @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  instituicao    Instituicao          @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  lancamento     LancamentoFinanceiro @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)

  lancamentosComissaoRH LancamentoComissaoRH[]

  @@index([instituicaoId])
  @@index([alunoId])
  @@index([lancamentoId])
}

model LancamentoFinanceiro {
  id              Int                        @id @default(autoincrement())
  tipo            TipoLancamentoFinanceiro
  descricao       String?
  valorOriginal   Float
  valorPago       Float?                     @default(0)
  vencimento      DateTime?
  pagoEm          DateTime?
  status          StatusLancamentoFinanceiro @default(PENDENTE)
  poloId          Int?
  polo            Polo?                      @relation(fields: [poloId], references: [id])
  observacao      String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  instituicaoId   Int
  alunoId         Int
  matriculaId     Int?
  descontoValor   Float?                     @default(0)
  jurosValor      Float?                     @default(0)
  multaValor      Float?                     @default(0)
  valorFinal      Float?                     @default(0)
  aluno           Aluno                      @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  instituicao     Instituicao                @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  matricula       Matricula?                 @relation(fields: [matriculaId], references: [id])
  movimentosCaixa MovimentoCaixa[]
  pagamentos      Pagamento[]

  @@index([instituicaoId])
  @@index([alunoId])
  @@index([matriculaId])
  @@index([status])
  @@index([tipo])
}

model DocumentoAluno {
  id                 Int                @id @default(autoincrement())
  titulo             String
  tipo               TipoDocumentoAluno
  proprietario       String             @default("ALUNO") // ALUNO | RESPONSAVEL
  arquivoUrl         String?
  arquivoNome        String?
  mimeType           String?
  tamanho            Int?
  conteudo           String?
  criadoEm           DateTime           @default(now())
  atualizadoEm       DateTime           @default(now()) @updatedAt
  alunoId            Int
  instituicaoId      Int
  matriculaId        Int?
  arquivado          Boolean            @default(false)
  arquivadoEm        DateTime?
  arquivadoPorId     Int?
  motivoArquivamento String?
  restauradoEm       DateTime?
  restauradoPorId    Int?
  motivoRestauracao  String?

  aluno       Aluno       @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  instituicao Instituicao @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  matricula   Matricula?  @relation(fields: [matriculaId], references: [id])

  @@index([alunoId])
  @@index([instituicaoId])
  @@index([proprietario])
  @@index([tipo])
}

model Disciplina {
  id                        Int                             @id @default(autoincrement())
  nome                      String
  cursoId                   Int?
  instituicaoId             Int
  descricao                 String?
  semestre                  Int?
  ativo                     Boolean                         @default(true)
  codigo                    String?
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt
  cargaHoraria              Int?
  certificados              Certificado[]
  semestresCurso            CursoSemestreDisciplina[]
  professorId               Int?
  professor                 Professor?                      @relation(fields: [professorId], references: [id])
  curso                     Curso?                          @relation(fields: [cursoId], references: [id])
  instituicao               Instituicao                     @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  resultadosFinais          ResultadoFinal[]
  itensMatricula            ItemMatricula[]
