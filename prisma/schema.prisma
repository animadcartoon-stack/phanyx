  @@index([professorId])
  @@index([publicadaEm])
}

model BibliotecaRecomendacaoDestino {
  id             Int @id @default(autoincrement())
  instituicaoId  Int
  recomendacaoId Int

  tipo TipoDestinoRecomendacaoBiblioteca

  cursoId      Int?
  turmaId      Int?
  disciplinaId Int?

  // Exemplos: TODOS, CURSO:12, TURMA:30 ou DISCIPLINA:8
  chaveDestino String

  criadoEm DateTime @default(now())

  recomendacao BibliotecaRecomendacao @relation(fields: [recomendacaoId, instituicaoId], references: [id, instituicaoId], onDelete: Cascade)

  curso Curso? @relation(fields: [cursoId, instituicaoId], references: [id, instituicaoId], onDelete: Restrict)

  turma Turma? @relation(fields: [turmaId, instituicaoId], references: [id, instituicaoId], onDelete: Restrict)

  disciplina Disciplina? @relation(fields: [disciplinaId, instituicaoId], references: [id, instituicaoId], onDelete: Restrict)

  @@unique([instituicaoId, recomendacaoId, chaveDestino])
  @@index([instituicaoId])
  @@index([recomendacaoId])
  @@index([tipo])
  @@index([cursoId])
  @@index([turmaId])
  @@index([disciplinaId])
}

