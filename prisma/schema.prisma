  reunioes                Reuniao[]

  documentosRH                                DocumentoRH[]
  feriasRH                                    FeriasRH[]
  examesRH                                    ExameMedicoRH[]
  rescisoesRH                                 RescisaoRH[]
  holeritesRH                                 HoleriteRH[]
  pagamentosHoleriteRH                        PagamentoHoleriteRH[]
  contasBancariasFuncionariosRH               ContaBancariaFuncionarioRH[]
  itensPagamentoHoleriteRH                    ItemPagamentoHoleriteRH[]
  pontosRH                                    PontoFuncionarioRH[]
  autorizacoesCorrecaoPontoRH                 AutorizacaoCorrecaoPontoRH[]
  solicitacoesCorrecaoPontoRH                 SolicitacaoCorrecaoPontoRH[]
  itensCorrecaoPontoRH                        SolicitacaoCorrecaoPontoItemRH[]
  avisosWhatsappCorrecaoPontoRH               AvisoWhatsappCorrecaoPontoRH[]
  historicosRH                                HistoricoRH[]
  ocorrenciasRH                               OcorrenciaRH[]
  escalasRH                                   EscalaTrabalhoRH[]
  bancoHorasRH                                BancoHorasRH[]
