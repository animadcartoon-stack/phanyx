model Matricula {
  id                                      Int             @id @default(autoincrement())
  numeroMatriculaLegado                   String?
  sistemaOrigem                           String?
  importadaSistemaAntigo                  Boolean         @default(false)
  alunoId                                 Int
  numeroMatricula                         String?
  modalidade                              String?
  createdAt                               DateTime        @default(now())
  instituicaoId                           Int
  poloId                                  Int?
  status                                  StatusMatricula @default(ATIVA)
  updatedAt                               DateTime        @updatedAt
  cursoId                                 Int?
  semestre                                Int?
  dataPrimeiroVencimento                  DateTime?
  quantidadeParcelas                      Int?
  valorMatricula                          Decimal?        @db.Decimal(10, 2)
  valorMensalidade                        Decimal?        @db.Decimal(10, 2)
  primeiroVencimento                      DateTime?
  quantidadeMensalidades                  Int?
  vendedorResponsavelId                   Int?
  vendedorResponsavelNomeSnapshot         String?
  leadOrigemId                            Int?            @unique
  origemComercial                         String?
  campanhaComercial                       String?
  atendidoComercialEm                     DateTime?
  observacaoComercial                     String?         @db.Text
  alunoMenorNoMomentoMatricula            Boolean         @default(false)
  idadeNoMomentoMatricula                 Int?
  responsavelIncompletoNoMomentoMatricula Boolean         @default(false)
  confirmacaoMenorEm                      DateTime?
  confirmacaoMenorPorUserId               Int?
  confirmacaoMenorPorFuncionarioId        Int?
  confirmacaoMenorPorNomeSnapshot         String?
  textoConfirmacaoMenor                   String?         @db.Text

  contratos               Contrato[]
  documentos              DocumentoAluno[]
  documentosGerados       DocumentoGerado[]
  itens                   ItemMatricula[]
  lancamentosFinanceiros  LancamentoFinanceiro[]
  vendedorResponsavel     Funcionario?                     @relation("MatriculaVendedorResponsavel", fields: [vendedorResponsavelId], references: [id], onDelete: SetNull)
  leadOrigem              Lead?                            @relation("LeadMatriculaConvertida", fields: [leadOrigemId], references: [id], onDelete: SetNull)
  participantesComerciais MatriculaParticipanteComercial[]
  lancamentosComissaoRH   LancamentoComissaoRH[]
  rematriculasComoOrigem  RematriculaSemestral[]           @relation("RematriculaMatriculaOrigem")

  rematriculaGeradora RematriculaSemestral? @relation("RematriculaMatriculaGerada")
  cursoSemestreId     Int?
  periodoMatriculaId  Int?
  periodoLetivo       String?
  realizadaPeloAluno  Boolean               @default(false)
  confirmadaEm        DateTime?
  cursoSemestre       CursoSemestre?        @relation(fields: [cursoSemestreId], references: [id])
  periodoMatricula    PeriodoMatricula?     @relation(fields: [periodoMatriculaId], references: [id])
  aluno               Aluno                 @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  curso               Curso?                @relation(fields: [cursoId], references: [id])
  instituicao         Instituicao           @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  polo                Polo?                 @relation(fields: [poloId], references: [id])

  confirmacaoMenorPorUser        User?        @relation("MatriculaConfirmacaoMenorPorUser", fields: [confirmacaoMenorPorUserId], references: [id], onDelete: SetNull)
  confirmacaoMenorPorFuncionario Funcionario? @relation("MatriculaConfirmacaoMenorPorFuncionario", fields: [confirmacaoMenorPorFuncionarioId], references: [id], onDelete: SetNull)

  @@unique([instituicaoId, numeroMatricula])
  @@index([instituicaoId])
  @@index([alunoId])
  @@index([cursoId])
  @@index([cursoSemestreId])
  @@index([periodoMatriculaId])
  @@index([periodoLetivo])
  @@index([poloId])
  @@index([numeroMatricula])
  @@index([numeroMatriculaLegado])
  @@index([vendedorResponsavelId])
  @@index([confirmacaoMenorPorUserId])
  @@index([confirmacaoMenorPorFuncionarioId])
  @@index([alunoMenorNoMomentoMatricula])
}

model ItemMatricula {
  id            Int                 @id @default(autoincrement())
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  instituicaoId Int
  matriculaId   Int
  turmaId       Int
