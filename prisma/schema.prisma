model WhatsAppMensagem {
  id            Int @id @default(autoincrement())
  instituicaoId Int

  whatsappInstituicaoId Int?
  templateId            Int?
  usuarioId             Int?

  tipoComunicacao TipoComunicacaoWhatsApp
  status          StatusWhatsAppMensagem  @default(PENDENTE)

  telefoneDestinatario String
  nomeDestinatario     String?

  mensagem String? @db.Text

  parametros Json?

  // Identifica de forma única uma comunicação originada
  // de um evento do PHANYX.
  //
  // Exemplo:
  // reuniao:35:lembrete:amanha:usuario:18
  //
  // Evita que cron, retry ou execuções concorrentes
  // disparem a mesma comunicação duas vezes.
  chaveIdempotencia String? @unique

  metaMessageId String? @unique

  tentativa Int @default(0)

  erroCodigo   String?
  erroMensagem String? @db.Text

  criadaEm     DateTime  @default(now())
  processadaEm DateTime?
  enviadaEm    DateTime?
  entregueEm   DateTime?
  lidaEm       DateTime?
  falhouEm     DateTime?

  atualizadoEm DateTime @updatedAt

  instituicao Instituicao @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)

  whatsappInstituicao WhatsAppInstituicao? @relation(fields: [whatsappInstituicaoId], references: [id], onDelete: SetNull)

  template WhatsAppTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  usuario User? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  eventos WhatsAppMensagemEvento[]

  @@index([instituicaoId])
  @@index([whatsappInstituicaoId])
  @@index([templateId])
  @@index([usuarioId])
  @@index([tipoComunicacao])
  @@index([status])
  @@index([criadaEm])
}

