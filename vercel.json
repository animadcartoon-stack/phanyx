{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "gru1"
  ],
  "functions": {
    "app/api/internal/crachas/processar-arquivo/route.ts": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "phanyx-crachas-emissao-massiva",
          "retryAfterSeconds": 60,
          "initialDelaySeconds": 0
        }
      ],
      "regions": [
        "iad1"
      ]
    },
    "app/api/admin/crachas/emitir-massivo/route.ts": {
      "regions": [
        "iad1"
      ]
    }
  },
  "crons": [
    {
      "path": "/api/admin/cron/limpar-cursos-excluidos",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/reunioes/lembretes",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/internal/comercial/captacao/integracoes/processar-fila",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/internal/student-success/reanalisar-prazos",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/internal/biblioteca/reservas/processar-expiradas",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/internal/financeiro/cancelamentos/processar",
      "schedule": "0 5 * * *"
    }
  ]
}
